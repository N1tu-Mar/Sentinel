# LLM
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# Lemma
LEMMA_API_KEY=
LEMMA_PROJECT_ID=

# Arga twins (values returned by the twin run; permanent env for production)
# Arga's documented names (STRIPE_TWIN_BASE_URL, SLACK_TWIN_BASE_URL, GOOGLE_ACCESS_TOKEN) are also accepted.
STRIPE_SECRET_KEY=                 # twin-issued key or real test key on fallback
STRIPE_API_BASE_URL=               # leave empty: Stripe runs on real test mode (the twin cannot create disputes)
STRIPE_WEBHOOK_SECRET=             # optional
SALESFORCE_API_BASE_URL=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_API_VERSION=v60.0
GMAIL_API_BASE_URL=
GMAIL_ACCESS_TOKEN=
SLACK_API_URL=                     # twin's /api/ base
SLACK_BOT_TOKEN=
SLACK_CHANNEL_DISPUTES=disputes
SLACK_CHANNEL_APPROVALS=dispute-approvals
SLACK_CHANNEL_RISK=risk

# Arga control plane (for seed/reset scripts and the eval harness)
ARGA_API_KEY=
ARGA_API_URL=                      # optional; defaults to https://api.argalabs.com
ARGA_SCENARIO_ID=
ARGA_TWIN_RUN_ID=
ARGA_TWIN_RUN_IDS=                  # comma-separated; set by npm run provision (one run per twin on the Free plan)
ARGA_TTL_MINUTES=10                # Free plan max 10; Team up to 480
ARGA_REPROVISION=                  # 1 = eval provisions fresh twins per scenario (Free plan TTL)
EVAL_SEED_MODE=                    # prompt = locate prompt-seeded data by email instead of seeding

# Store (in-memory fallback when absent)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local sandbox (set by npm run sandbox via .env.development.local): Salesforce, Gmail and Slack stand-in while Arga runs are unavailable
SANDBOX_URL=

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_LEMMA_TRACE_URL=        # optional: Lemma trace URL template with {id}
AUTO_RUN=false
